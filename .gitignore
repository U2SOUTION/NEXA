# ============================================
# NEXA Monorepo - Root .gitignore
# ============================================

# 의존성 (모든 하위 프로젝트)
**/node_modules/
node_modules/
NEXA-Documentation/

# 빌드 결과물
**/dist/
**/build/
**/.output/
dist/
build/

# Quasar 관련 (NEXA-Platform)
**/.quasar/
.quasar/
**/quasar.config.*.temporary.compiled*

# Vite 캐시
**/.vite/
.vite/

# PlatformIO (NEXA-Edeg)
**/.pio/
.pio/

# VS Code Extension 빌드 (DEV)
**/out/
out/
**/.vscode-test/
.vscode-test/
**/*.vsix

# 캐시 및 임시 파일
**/.cache/
.cache/
**/.temp/
.temp/
**/*.tmp
*.tmp

# Cursor IDE 임시 파일
**/.cursor/
.cursor/

# Python 캐시 (NEXA-Desktop)
**/__pycache__/
__pycache__/
**/*.pyc
*.pyc
**/*.pyo
*.pyo
**/*.pyd
*.pyd
**/.Python
.Python

# 로그 파일
**/*.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 운영체제 파일
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
thumbs.db
Desktop.ini

# 환경 변수·Secret (로컬, git/cursor 제외)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# 테스트 커버리지
**/coverage/
coverage/
**/.nyc_output/
.nyc_output/

# IDE 설정 (선택적 - 필요시 주석 해제)
# .vscode/
# .idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln

# VS Code C/C++ 관련 (ESP32 프로젝트)
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# 패키지 매니저
**/.pnpm-store/
.pnpm-store/
**/.yarn/
.yarn/
**/.pnp.*
.pnp.*

# 사용자 업로드 파일 (폴더 구조는 유지)
**/uploads/*
!**/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Cursor IDE 임시 이미지 파일
**/assets/
assets/

# 특수 문자 파일
**/*date=short*

# Cordova/Capacitor (NEXA-Platform)
**/src-cordova/node_modules/
**/src-cordova/platforms/
**/src-cordova/plugins/
**/src-cordova/www/
**/src-capacitor/www/
**/src-capacitor/node_modules/

# 기타 임시 파일
**/*.swp
**/*.swo
**/*~
*~

# 디자인 소스 파일 (Adobe, Figma 등)
**/*.ai
*.ai
**/*.psd
*.psd
**/*.sketch
*.sketch
**/*.fig
*.fig
**/*.xd
*.xd
**/*.indd
*.indd
**/*.afdesign
*.afdesign

# 3D 모델 파일
**/*.stl
*.stl
**/*.obj
*.obj
**/*.step
*.step
**/*.iges
*.iges
**/*.3mf
*.3mf
**/*.ply
*.ply
**/*.blend
*.blend
**/*.max
*.max
**/*.fbx
*.fbx
**/*.dae
*.dae
**/*.3ds
*.3ds
**/*.x3d
*.x3d
**/*.x3db
*.x3db

