# ============================================
# NEXA-Platform 환경 변수 예시
# ============================================
# 이 파일을 .env로 복사 후 실제 값으로 수정
# .env는 git, AI 검색에서 제외됨
# 루트(NEXA-Platform/)에 하나의 .env만 둠
#
# [구분]
# - VITE_ 접두사: 프론트엔드에 노출 (공개). 빌드 시 import.meta.env.VITE_* 로 주입
# - VITE_ 없음: 서버 전용 (비공개·비밀). process.env.* 로만 접근. 프론트에 노출 금지
# ============================================

# ----------------------------------------
# 서버 전용 (비공개·Strict Secrets)
# server/config/*.js 에서 process.env로 읽음
# ----------------------------------------

# server/server.js
PORT=3001
NODE_ENV=development
FRONTEND_DIST=

# server/routes/files.routes.js
API_BASE_URL=http://localhost:3001

# server/config/dbConfig.js (Postgres)
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=디비비밀번호
PGDATABASE=nexa_db
PGPORT=5432

# server/config/aiConfig.js
OLLAMA_URL=http://localhost:11434

# server/config/upload.js
UPLOAD_BASE_DIR=public/uploads

# server/config/bodyLimits.js
JSON_BODY_LIMIT=15mb
URLENCODED_BODY_LIMIT=15mb

# 인증 [NEXA-AUTH-01]
JWT_SECRET=변경필요-32자이상-랜덤
JWT_REFRESH_SECRET=변경필요-32자이상-랜덤
# JWT 만료: access 1h, refresh 7d (기본값). 초 단위로 오버라이드 가능
# JWT_ACCESS_EXPIRY=3600
# JWT_REFRESH_EXPIRY=604800

# Redis (필수 — 로그아웃 블랙리스트, 추후 Device Token 캐시·비밀번호 리셋)
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# OLLAMA_API_KEY=

# Cloudflare (Tunnel / API 사용 시)
# CLOUDFLARE_TUNNEL_TOKEN=   # Cloudflare Tunnel 토큰 (docker-compose tunnel 서비스용)
# CLOUDFLARE_API_KEY=       # Cloudflare API 토큰 (Dashboard → My Profile → API Tokens. DNS·Workers 등 API 호출용)

# docker-compose (Docker 배포 시)
# PG* 는 dbConfig와 동일. Postgres 컨테이너 초기화 시 POSTGRES_USER=${PGUSER} 등으로 참조

# ----------------------------------------
# 프론트엔드 노출 (공개·Public Config)
# VITE_ 접두사 필수. 빌드 시 import.meta.env.VITE_* 로 주입
# ----------------------------------------
VITE_API_BASE_URL=
VITE_API_PORT=3001
# VITE_MQTT_WSS_URL=wss://example.com/mqtt
# VITE_THEME_COLOR=primary
