{
  "name": "quasar-project",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "U2 SOLUTION",
  "author": "U2 <infomasi@naver.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,ts,vue}\"",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:strict": "vue-tsc --noEmit -p tsconfig.strict.json",
    "typecheck:strict:all": "cd server && npm run typecheck:strict && cd .. && npm run typecheck:strict",
    "typecheck:server": "cd server && npm run typecheck",
    "typecheck:all": "npm run typecheck:server && npm run typecheck",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "cross-env VITE_API_PORT=3001 quasar dev",
    "dev:server": "cd server && npm run dev",
    "dev:all": "npm run dev:kill-ports && concurrently -n \"FRONTEND,API,BROWSER\" -c \"cyan,magenta,yellow\" \"npm run dev\" \"npm run dev:server\" \"wait-on http://localhost:9000 -t 60000 && node scripts/open-browser.js\"",
    "start:server": "cd server && npm start",
    "start:all": "concurrently -n \"FRONTEND,API\" -c \"cyan,magenta\" \"npm run dev\" \"npm run start:server\"",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "test:unit": "vitest",
    "dev:kill-ports": "kill-port 3001 9000 9001"
  },
  "dependencies": {
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.7",
    "@quasar/extras": "^1.16.4",
    "@tiptap/extension-audio": "^3.20.0",
    "@tiptap/extension-color": "^3.11.0",
    "@tiptap/extension-font-family": "^3.11.0",
    "@tiptap/extension-highlight": "^3.10.7",
    "@tiptap/extension-image": "^3.10.7",
    "@tiptap/extension-link": "^3.10.7",
    "@tiptap/extension-subscript": "^3.11.0",
    "@tiptap/extension-superscript": "^3.11.0",
    "@tiptap/extension-table": "^3.10.7",
    "@tiptap/extension-table-cell": "^3.10.7",
    "@tiptap/extension-table-header": "^3.10.7",
    "@tiptap/extension-table-row": "^3.10.7",
    "@tiptap/extension-task-item": "^3.10.7",
    "@tiptap/extension-task-list": "^3.10.7",
    "@tiptap/extension-text-align": "^3.10.7",
    "@tiptap/extension-text-style": "^3.11.0",
    "@tiptap/extension-underline": "^3.10.7",
    "@tiptap/extension-youtube": "^3.11.0",
    "@tiptap/starter-kit": "^3.10.7",
    "@tiptap/vue-3": "^3.10.7",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.2",
    "qrcode": "^1.5.4",
    "quasar": "^2.16.0",
    "splitpanes": "^4.0.3",
    "uuid": "^13.0.0",
    "vue": "^3.4.18",
    "vue-router": "^4.0.0",
    "vue3-grid-layout-next": "^1.0.7",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/ui": "^4.0.16",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vite-plugin-checker": "^0.9.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^2.1.10",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
