{
    "manifest_version": 3,
    "name": "U2BEE V3",
    "version": "3.0.0",
    "description": "YouTube Content Manager - NEXA Platform 통합 버전",
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:* https://localhost:*"
    },
    "permissions": ["storage", "tabs", "activeTab", "sidePanel", "scripting"],
    "host_permissions": ["http://localhost:*/*", "https://localhost:*/*", "*://*.youtube.com/*", "https://*.youtube.com/*", "https://img.youtube.com/*", "<all_urls>"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_matches": ["*://localhost/*", "*://127.0.0.1/*"],
            "js": ["content/content.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["<all_urls>"],
            "exclude_matches": ["*://localhost/*", "*://127.0.0.1/*"],
            "js": ["content/injectUI.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon16.png",
            "32": "assets/icon32.png",
            "48": "assets/icon48.png",
            "128": "assets/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    }
}
